[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/aviso_historico.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/fondo_inicio.png" id="2_fondo"]
[ext_resource type="Texture2D" path="res://assets/bonus/danger.png" id="3_danger"]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
bg_color = Color(0.015, 0.018, 0.025, 0.94)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.92, 0.08, 0.06, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="Style_button"]
bg_color = Color(0.22, 0.025, 0.025, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.12, 0.08, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="AvisoHistorico" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Fondo" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_fondo")
expand_mode = 1
stretch_mode = 6

[node name="Oscurecer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.76)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 0
offset_left = 220.0
offset_top = 70.0
offset_right = 1060.0
offset_bottom = 650.0
theme_override_styles/panel = SubResource("Style_panel")

[node name="Margen" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 58
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 58
theme_override_constants/margin_bottom = 30

[node name="Contenido" type="VBoxContainer" parent="Panel/Margen"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Danger" type="TextureRect" parent="Panel/Margen/Contenido"]
custom_minimum_size = Vector2(0, 104)
layout_mode = 2
texture = ExtResource("3_danger")
expand_mode = 1
stretch_mode = 5

[node name="Titulo" type="Label" parent="Panel/Margen/Contenido"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.18, 0.12, 1)
theme_override_font_sizes/font_size = 30
text = "AVISO"
horizontal_alignment = 1

[node name="Texto" type="Label" parent="Panel/Margen/Contenido"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.94, 0.94, 0.92, 1)
theme_override_font_sizes/font_size = 23
text = "Esta historia se inspira en sucesos reales del pasado, abordados desde el máximo respeto hacia todos sus actores.\n\nCon el fin de construir la experiencia de juego, se han introducido elementos, personajes y situaciones completamente ficticias."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="Continuar" type="Button" parent="Panel/Margen/Contenido"]
custom_minimum_size = Vector2(0, 62)
layout_mode = 2
theme_override_font_sizes/font_size = 22
theme_override_styles/normal = SubResource("Style_button")
text = "IR AL JUEGO"

[connection signal="pressed" from="Panel/Margen/Contenido/Continuar" to="." method="_on_continuar_pressed"]
