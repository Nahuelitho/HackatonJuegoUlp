[sub_resource type="Shader" id="Shader_gris"]
code = "shader_type canvas_item;

void fragment() {
	vec4 color = texture(TEXTURE, UV) * COLOR;
	float gris = dot(color.rgb, vec3(0.299, 0.587, 0.114));
	color.rgb = mix(color.rgb, vec3(gris), 0.86) * vec3(0.68, 0.7, 0.74);
	COLOR = color;
}
"

[sub_resource type="ShaderMaterial" id="Material_gris"]
shader = SubResource("Shader_gris")

[sub_resource type="Shader" id="Shader_siluetas"]
code = "shader_type canvas_item;

void fragment() {
	vec4 color = texture(TEXTURE, UV);
	float brillo = dot(color.rgb, vec3(0.299, 0.587, 0.114));
	float mascara = 1.0 - smoothstep(0.72, 0.94, brillo);
	COLOR = vec4(vec3(0.025, 0.028, 0.035), mascara * color.a * COLOR.a);
}
"

[sub_resource type="ShaderMaterial" id="Material_siluetas"]
shader = SubResource("Shader_siluetas")

